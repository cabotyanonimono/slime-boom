#include "compute_common.hlsli"
#include "slime_globals.hlsli"
#include "slime.hlsli"
#include "math.hlsli"

cbuffer SlimeSpeed : register(b2)
{
    float slime_speed;
}

RWStructuredBuffer<SlimeData> slimes : register(u0);

[numthreads(64, 1, 1)]
void CSMain(uint3 globalID : SV_DispatchThreadID)
{
    uint index = globalID.x;
    
    slimes[index].velocity += normalize(player_pos - slimes[index].position) * slime_speed * deltatime;
}