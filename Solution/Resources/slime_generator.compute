#define SLIME_TYPE_PARAMS_REGISTER t0
#include "compute_common.hlsli"
#include "slime_globals.hlsli"
#include "slime.hlsli"
#include "math.hlsli"

cbuffer SpawnDistance : register(b2)
{
    float spawn_distance_min;
    float spawn_distance_max;
}

// 種類の表の並び順ごとの出現率(SlimeSimulationComponent::SetSpawnRateで設定する)
StructuredBuffer<float> slime_spawn_rates : register(t1);

RWStructuredBuffer<SlimeData> slimes : register(u0);

// 出現率の重みで種類を抽選する。seedは0〜1。
int DecideSpawnSlimeType(float seed)
{
    uint type_count = GetSlimeTypeCount();

    float sum_spawn_rate = 0.0f;
    for (uint i = 0; i < type_count; ++i)
        sum_spawn_rate += slime_spawn_rates[i];

    seed *= sum_spawn_rate;
    for (uint j = 0; j < type_count; ++j)
    {
        if (seed < slime_spawn_rates[j])
            return (int)j;
        seed -= slime_spawn_rates[j];
    }
    return 0;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 globalID : SV_DispatchThreadID)
{
    uint index = globalID.x;
    
    if (index < slime_count && slimes[index].hp <= 0.0f)
    {
        float random = rand(float2(index, time));
        slimes[index].slime_type = DecideSpawnSlimeType(random);

        float angle = rand(float2(time, index)) * PI2;
        float spawn_distance = lerp(spawn_distance_min, spawn_distance_max, rand(float2(index * time, deltatime)));

        slimes[index].position.x = player_pos.x + spawn_distance * cos(angle);
        slimes[index].position.y = player_pos.y;
        slimes[index].position.z = player_pos.z + spawn_distance * sin(angle);

        slimes[index].rotation = float3(0, 0, 0);
        slimes[index].scale = float3(1, 1, 1);

        slimes[index].velocity = float3(0, 0, 0);
        slimes[index].angular_velocity = float3(0, 0, 0);
        slimes[index].hp = GetSlimeTypeParams(slimes[index].slime_type).max_hp;
		slimes[index].damage_color_timer = 0.0f;
    }
}