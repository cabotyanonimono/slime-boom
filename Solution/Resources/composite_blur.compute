#include "engine.hlsli"

Texture2D main_texture : register (t3);
Texture2D blur_texture : register (t4);

RWTexture2D<float4> output_texture : register(u1);

cbuffer TextureSize : register(b2)
{
    float2 texture_size;
}

float3 ACESFilm(float3 x)
{
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

float3 LinearToGamma(float3 color)
{
    return pow(color, 1.0f / 2.2f);
}

[numthreads(16, 16, 1)]
void compute(uint3 globalID : SV_DispatchThreadID)
{
    uint2 pos = globalID.xy;

    if (pos.x >= texture_size.x || pos.y >= texture_size.y)
        return;
	
    float2 texel_size = 1.0f / float2(texture_size.x, texture_size.y);
    float2 uv = (float2(pos) + 0.5f) * texel_size;
    
    float3 main_color = main_texture[pos].rgb;
    float3 blur_color = blur_texture.SampleLevel(SmpClamp, uv, 0.0f);

    float3 final_color = main_color + (blur_color * 1.5f);

	final_color = ACESFilm(final_color);

    output_texture[pos] = float4(final_color, 1.0f);
}